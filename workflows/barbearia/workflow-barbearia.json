    {
      "parameters": {
        "jsCode": "// Processar dados e gerar estatísticas\nconst hoje = new Date();\nhoje.setHours(0, 0, 0, 0);\n\nconst agendamentos = $input.all();\nconst stats = {\n  confirmados: 0,\n  cancelados: 0,\n  valor_confirmados: 0,\n  valor_cancelados: 0\n};\n\nagendamentos.forEach(item => {\n  const dataAgendamento = new Date(item.json.criado_em);\n  if (dataAgendamento >= hoje && dataAgendamento < new Date(hoje.getTime() + 86400000)) {\n    if (item.json.status === 'confirmado') {\n      stats.confirmados++;\n      stats.valor_confirmados += parseFloat(item.json.valor || 0);\n    } else if (item.json.status === 'cancelado') {\n      stats.cancelados++;\n      stats.valor_cancelados += parseFloat(item.json.valor || 0);\n    }\n  }\n});\n\nreturn {\n  json: {\n    data: hoje.toISOString().split('T')[0],\n    total_agendamentos: stats.confirmados + stats.cancelados,\n    confirmados: stats.confirmados,\n    cancelados: stats.cancelados,\n    receita_total: stats.valor_confirmados,\n    receita_cancelada: stats.valor_cancelados\n  }\n};"
      },
      "id": "code-processar-stats",
      "name": "Code - Processar Estatísticas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 1600]
    },
